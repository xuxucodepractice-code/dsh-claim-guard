{
  "name": "dsh-claim-guard",
  "version": "0.1.0",
  "description": "A deterministic pre-write claim guard for supported DeepSeek Harness file tools.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "claims.example.json",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --test",
    "prepack": "npm run check",
    "benchmark": "node --expose-gc scripts/benchmark.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agent",
    "claim-checking"
  ],
  "license": "MIT",
  "author": "xuxucodepractice-code <xuxucodepractice@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuxucodepractice-code/dsh-claim-guard.git"
  },
  "homepage": "https://github.com/xuxucodepractice-code/dsh-claim-guard#readme",
  "bugs": {
    "url": "https://github.com/xuxucodepractice-code/dsh-claim-guard/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
